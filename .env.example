# Render: exact Netlify origin, no trailing slash. Comma-separate explicit extra origins.
ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
# Netlify build only: the Render service origin (not a secret).
PUBLIC_GAME_SERVER_URL=https://YOUR-SERVICE.onrender.com
# Local development defaults to 3000; Render injects PORT automatically.
PORT=3000
